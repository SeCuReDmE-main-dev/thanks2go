{
  "manifest_version": 3,
  "name": "Thanks2Go Profile Inspector",
  "version": "0.1.0",
  "description": "Inspect an explicitly declared Thanks2Go profile after a user click.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": { "default_title": "Inspect gratitude profile", "default_popup": "popup.html" }
}
