{
  "name": "thanks2go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"tsx watch api/local.ts\" \"npm run dev -w @thanks2go/web\"",
    "build": "npm run build -w @thanks2go/web && npm run build -w @thanks2go/extension",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "package:extension": "npm run package -w @thanks2go/extension"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@solana-commerce/kit": "0.1.1",
    "bs58": "6.0.0",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jose": "6.2.11",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.4",
    "tsx": "4.20.5",
    "supertest": "7.1.4",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
